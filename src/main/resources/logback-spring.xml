<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- DEV: console + rolling file (path driven by logging.file.name in application-dev.yml) -->
    <springProfile name="dev">
        <include resource="org/springframework/boot/logging/logback/file-appender.xml"/>
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- TEST: console + rolling file (path driven by logging.file.name in application-test.yml) -->
    <springProfile name="test">
        <include resource="org/springframework/boot/logging/logback/file-appender.xml"/>
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- STAGING: console + rolling file uploaded to S3 on each daily roll -->
    <springProfile name="staging">
        <springProperty name="LOG_S3_BUCKET" source="logging.s3.bucket"/>
        <springProperty name="LOG_S3_PREFIX" source="logging.s3.prefix" defaultValue="staging/"/>
        <springProperty name="LOG_S3_REGION" source="logging.s3.region" defaultValue="eu-central-1"/>

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>/var/log/peecko_api/peecko-api-staging.log</file>
            <encoder>
                <pattern>${FILE_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="com.peecko.api.logging.S3RollingPolicy">
                <fileNamePattern>/var/log/api/archived/peecko-api-staging.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>7</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>
                <s3BucketName>${LOG_S3_BUCKET}</s3BucketName>
                <s3KeyPrefix>${LOG_S3_PREFIX}</s3KeyPrefix>
                <awsRegion>${LOG_S3_REGION}</awsRegion>
            </rollingPolicy>
        </appender>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- PROD: console + rolling file uploaded to S3 on each daily roll -->
    <springProfile name="prod">
        <springProperty name="LOG_S3_BUCKET" source="logging.s3.bucket"/>
        <springProperty name="LOG_S3_PREFIX" source="logging.s3.prefix" defaultValue="prod/"/>
        <springProperty name="LOG_S3_REGION" source="logging.s3.region" defaultValue="eu-central-1"/>

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>/var/log/peecko_api/peecko-api-prod.log</file>
            <encoder>
                <pattern>${FILE_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
            <rollingPolicy class="com.peecko.api.logging.S3RollingPolicy">
                <fileNamePattern>/var/log/api/archived/peecko-api-prod.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>7</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>
                <s3BucketName>${LOG_S3_BUCKET}</s3BucketName>
                <s3KeyPrefix>${LOG_S3_PREFIX}</s3KeyPrefix>
                <awsRegion>${LOG_S3_REGION}</awsRegion>
            </rollingPolicy>
        </appender>

        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>
    </springProfile>

    <!-- ALL OTHER PROFILES: console only -->
    <springProfile name="!dev,!staging,!prod,!test">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>
